{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Shared Packages",
      "type": "shell",
      "command": "npm run build:types && npm run build:core",
      "options": {
        "cwd": "${workspaceFolder}/ai-agent-platform"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "startup"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Start Agent API",
      "type": "shell",
      "command": "npm run dev:api",
      "options": {
        "cwd": "${workspaceFolder}/ai-agent-platform"
      },
      "isBackground": true,
      "dependsOn": "Build Shared Packages",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Agent UI",
      "type": "shell",
      "command": "npm run dev:ui",
      "options": {
        "cwd": "${workspaceFolder}/ai-agent-platform"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Demo Server",
      "type": "shell",
      "command": "PORT=4000 node scripts/demo-server.mjs",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Unit Tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "tests"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Multi-User Stress Test",
      "type": "shell",
      "command": "MAX_GLOBAL_AGENTS=3 STRESS_JOBS=3 STRESS_PARALLEL_AGENTS=3 npm run stress:multiuser",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Start Agent API",
        "Start Demo Server"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "tests"
      },
      "problemMatcher": []
    },
    {
      "label": "Install Playwright Browsers",
      "type": "shell",
      "command": "PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-/home/codespace/.cache/ms-playwright} npx playwright install --with-deps chromium",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "setup"
      },
      "problemMatcher": []
    },
    {
      "label": "Start All Projects",
      "dependsOn": [
        "Install Playwright Browsers",
        "Start Agent API",
        "Start Agent UI",
        "Start Demo Server",
        "Run Unit Tests"
      ],
      "dependsOrder": "parallel",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
