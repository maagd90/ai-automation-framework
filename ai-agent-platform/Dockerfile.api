FROM node:20-bookworm-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
COPY ai-agent-platform ./ai-agent-platform
COPY src ./src
COPY tsconfig.json ./
RUN npm ci
RUN npm run build
WORKDIR /app/ai-agent-platform
RUN npm ci
RUN npm run build:types && npm run build -w @ai-agent/agent-core && npm run build -w @ai-agent/agent-api

FROM node:20-bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxkbcommon0 \
    libgbm1 \
    libasound2 \
    libxshmfence1 \
    libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/ai-agent-platform/apps/agent-api/dist ./ai-agent-platform/apps/agent-api/dist
COPY --from=builder /app/ai-agent-platform/packages ./ai-agent-platform/packages
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/ai-agent-platform/node_modules ./ai-agent-platform/node_modules
COPY --from=builder /app/ai-agent-platform/apps/agent-api/package.json ./ai-agent-platform/apps/agent-api/package.json
COPY --from=builder /app/package.json ./package.json

RUN npx playwright install chromium

ENV NODE_ENV=production
ENV PORT=3001
ENV JOBS_DIR=/tmp/jobs
EXPOSE 3001
CMD ["node", "ai-agent-platform/apps/agent-api/dist/server.js"]
