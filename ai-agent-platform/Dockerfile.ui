FROM node:20-alpine AS builder
WORKDIR /app/ai-agent-platform/apps/agent-ui
ARG VITE_API_URL=/api
ARG VITE_FORCE_HEADLESS=false
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_FORCE_HEADLESS=$VITE_FORCE_HEADLESS
COPY ai-agent-platform/apps/agent-ui/package.json ./
COPY ai-agent-platform/package.json ../package.json
COPY ai-agent-platform/packages/shared-types ../packages/shared-types
RUN npm ci --workspace=@ai-agent/agent-ui || npm install
COPY ai-agent-platform/apps/agent-ui ./
COPY ai-agent-platform/packages/shared-types ../packages/shared-types
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/ai-agent-platform/apps/agent-ui/dist /usr/share/nginx/html
COPY ai-agent-platform/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
