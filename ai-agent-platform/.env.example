
# ── Concurrency ──────────────────────────────────────────────────────────────
MAX_GLOBAL_AGENTS=1
MAX_GLOBAL_AGENTS_HARD_LIMIT=4
MAX_PARALLEL_AGENTS_PER_JOB=1
MAX_PARALLEL_AGENTS_PER_JOB_HARD_LIMIT=4

# ── Dynamic agent autoscaling ─────────────────────────────────────────────────
AUTO_OPTIMIZE_AGENTS=true
MIN_AGENTS=1
AGENT_MEMORY_MB=500
SYSTEM_RESERVED_MEMORY_MB=1024
# One agent is targeted per N test cases in auto allocation mode
TEST_CASES_PER_AGENT_TARGET=5

# ── Demo / cost safety limits ─────────────────────────────────────────────────
MAX_TEST_CASES_PER_JOB=5
MAX_TEST_CASES_HARD_LIMIT=20
MAX_DAILY_JOBS_PER_IP=20
JOB_RETENTION_HOURS=24

# ── Playwright runtime ────────────────────────────────────────────────────────
INSTALL_GENERATED_PROJECT_DEPS=false
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ── Feature flags (all off by default for a safe public demo) ─────────────────
ENABLE_AI_PROVIDERS=false
ENABLE_LOCAL_LLM=false
ENABLE_TRACE_VIDEO=false
ENABLE_BATCH_LARGE_UPLOAD=false
ENABLE_ADMIN_PANEL=false
