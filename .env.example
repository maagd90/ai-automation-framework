# Copy this file to .env and fill required values

# =========================
# SERVER CONFIG
# =========================
PORT=3001
NODE_ENV=production

# =========================
# DEMO MODE (IMPORTANT)
# =========================
DEMO_MODE=true

# =========================
# AGENT LIMITS (MAC SAFE)
# =========================
MAX_GLOBAL_AGENTS=1
MAX_PARALLEL_AGENTS_PER_JOB=1
MAX_TEST_CASES_PER_JOB=5

# =========================
# PLAYWRIGHT CONFIG
# =========================
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# =========================
# EXECUTION CONFIG
# =========================
INSTALL_GENERATED_PROJECT_DEPS=false

# =========================
# STORAGE CONFIG
# =========================
JOBS_DIR=/tmp/jobs
JOB_RETENTION_HOURS=24

# =========================
# AI CONFIG (OPTIONAL)
# =========================
ENABLE_ADVANCED_AI=true
ENABLE_LOCAL_LLM=false
ENABLE_TRACE_VIDEO=false

# Gemini (fill in your key — never commit a real value)
GEMINI_API_KEY=

# =========================
# CORS CONFIG
# =========================
# Do NOT add Cloudflare tunnel URLs here — dynamic *.trycloudflare.com origins
# are handled automatically by backend CORS logic when DEMO_MODE=true.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =========================
# SECURITY
# =========================
ALLOWED_FILE_TYPES=.json,.txt,.feature
MAX_FILE_SIZE_MB=2

# =========================
# LOGGING
# =========================
LOG_LEVEL=info
