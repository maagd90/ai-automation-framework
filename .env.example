# ── AI Providers ──────────────────────────────────────────────────────────────
# Only fill in GEMINI_API_KEY when running a Gemini-enabled demo.
# Never commit this file with real key values.
GEMINI_API_KEY=

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_AI_PROVIDERS=true
ENABLE_LOCAL_LLM=false
ENABLE_TRACE_VIDEO=false
ENABLE_BATCH_LARGE_UPLOAD=false
ENABLE_ADMIN_PANEL=false

# ── Demo mode ─────────────────────────────────────────────────────────────────
DEMO_MODE=true

# ── Concurrency — MacBook Air 8 GB safe settings ─────────────────────────────
MAX_GLOBAL_AGENTS=1
MAX_PARALLEL_AGENTS_PER_JOB=1
MAX_TEST_CASES_PER_JOB=5

# ── Playwright runtime ────────────────────────────────────────────────────────
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
INSTALL_GENERATED_PROJECT_DEPS=false

# ── Job storage ───────────────────────────────────────────────────────────────
JOBS_DIR=/tmp/jobs
JOB_RETENTION_HOURS=24

# ── API server ────────────────────────────────────────────────────────────────
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
